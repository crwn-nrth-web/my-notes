views:
  - type: table
    name: Table
    filters:
      and:
        - file.tags.contains("philosophy")
    order:
      - file.name
      - file.tags
      - aliases
  - type: table
    name: philosophy
    filters:
      and:
        - file.tags.contains("philosophy")
    order:
      - file.name
      - file.tags
