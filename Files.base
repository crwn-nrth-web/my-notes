views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("content")
        - '!file.inFolder("content/images")'
    order:
      - file.name
      - file.tags
      - aliases
    sort:
      - property: file.tags
        direction: ASC
  - type: table
    name: philosophy
    filters:
      and:
        - file.tags.contains("philosophy")
    order:
      - file.name
      - file.tags
